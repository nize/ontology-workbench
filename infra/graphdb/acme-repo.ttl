# GraphDB repository config for the workbench.
# The "empty" ruleset disables inference so query results match the
# Oxigraph backend (inferred transitive subClassOf would flatten the type tree).
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix config: <tag:rdf4j.org,2023:config/> .
@prefix graphdb: <http://www.ontotext.com/config/graphdb#> .

<#acme> a config:Repository ;
  config:rep.id "acme" ;
  rdfs:label "Ontology Workbench (acme)" ;
  config:rep.impl [
    config:rep.type "graphdb:SailRepository" ;
    config:sail.impl [
      config:sail.type "graphdb:Sail" ;
      graphdb:ruleset "empty" ;
      graphdb:disable-sameAs "true"
    ]
  ] .
